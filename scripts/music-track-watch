#!/bin/bash

LAST_TRACK=""

# Apply colors immediately for whatever is currently playing.
~/outlaw-rice/scripts/album-cava-colors 2>/dev/null

while true; do
    TRACK=$(playerctl metadata mpris:trackid 2>/dev/null)

    if [ -n "$TRACK" ] && [ "$TRACK" != "$LAST_TRACK" ]; then
        LAST_TRACK="$TRACK"

        ~/outlaw-rice/scripts/album-cava-colors 2>/dev/null
    fi

    sleep 2
done
