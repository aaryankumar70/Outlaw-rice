                rgba(
                    8,
                    13,
                    16,
                    0.74
                );

            border:
                1px solid
                rgba(
                    222,
                    227,
                    229,
                    0.14
                );

            border-radius: 18px;

            padding: 12px;
        }}


        #profile {{
            background:
                rgba(
                    255,
                    255,
                    255,
                    0.04
                );

            border:
                1px solid
                rgba(
                    222,
                    227,
                    229,
                    0.12
                );

            border-radius: 50%;
        }}


