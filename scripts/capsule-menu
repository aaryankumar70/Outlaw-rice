            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )


    # ========================================================
    # BUILD PANEL
    # ========================================================

    def build_panel(self):

        panel = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=8,
        )

        panel.set_name(
            "capsule-panel"
        )

        panel.set_size_request(
            WIDTH,
            -1,
        )


        # ====================================================
        # HEADER
        # ====================================================

        header = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8,
        )


        profile = Gtk.DrawingArea()

        profile.set_size_request(
            32,
            32,
        )

        profile.set_name(
            "profile"
        )


        profile_pixbuf = None

        if PROFILE.exists():

            try:

                profile_pixbuf = (
                    GdkPixbuf.Pixbuf.new_from_file(
                        str(PROFILE)
                    )
                )

                profile_pixbuf = (
                    profile_pixbuf.scale_simple(
                        32,
                        32,
                        GdkPixbuf.InterpType.BILINEAR,
                    )
                )

            except Exception:
                profile_pixbuf = None


        def draw_profile(widget, cr):

            allocation = (
                widget.get_allocation()
            )

            size = min(
                allocation.width,
                allocation.height,
            )

            cr.arc(
                size / 2,
                size / 2,
                size / 2,
                0,
                2 * math.pi,
            )

            cr.clip()

            if profile_pixbuf:

                Gdk.cairo_set_source_pixbuf(
                    cr,
                    profile_pixbuf,
                    0,
                    0,
                )

                cr.paint()

            else:

                cr.set_source_rgba(
                    0.52,
                    0.82,
                    0.91,
                    0.20,
                )

                cr.paint()


        profile.connect(
            "draw",
            draw_profile,
        )


        header.pack_start(
            profile,
            False,
            False,
            0,
        )


        title_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=1,
        )


        title = Gtk.Label(
            label="OUTLAW"
        )

        title.set_name(
            "title"
        )

        title.set_xalign(
            0
        )


        subtitle = Gtk.Label(
            label="SYSTEM CAPSULE"
        )

        subtitle.set_name(
            "subtitle"
        )

        subtitle.set_xalign(
            0
        )


        title_box.pack_start(
            title,
            False,
            False,
            0,
        )

        title_box.pack_start(
            subtitle,
            False,
            False,
            0,
        )


        header.pack_start(
            title_box,
            True,
            True,
            0,
        )


        panel.pack_start(
            header,
            False,
            False,
            0,
        )


        # ====================================================
        # SYSTEM
        # ====================================================

        system_label = Gtk.Label(
            label="SYSTEM"
        )

        system_label.set_name(
            "section-label"
        )

        system_label.set_xalign(
            0
        )


        panel.pack_start(
            system_label,
            False,
            False,
            0,
        )


        indicators = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=2,
        )


        self.volume = CircularIndicator(
            "VOLUME",
            "󰕾",
            ACCENT,
            52,
            True,
        )

        self.cpu = CircularIndicator(
            "CPU",
            "󰻠",
            ACCENT,
            52,
        )

        self.ram = CircularIndicator(
            "RAM",
            "󰍛",
            ACCENT,
            52,
        )

        self.battery = CircularIndicator(
            "BATTERY",
            "󰁹",
            PURPLE,
            52,
        )

        self.brightness = CircularIndicator(
            "BRIGHTNESS",
            "󰃠",
            PURPLE,
            52,
            True,
        )


        for item in [
            self.volume,
            self.cpu,
            self.ram,
            self.battery,
            self.brightness,
        ]:

            indicators.pack_start(
                item,
                True,
                True,
                0,
            )


        panel.pack_start(
            indicators,
            False,
            False,
            0,
        )


        # ====================================================
        # CONNECTION
        # ====================================================

        connection_label = Gtk.Label(
            label="CONNECTION"
        )

        connection_label.set_name(
            "section-label"
        )

        connection_label.set_xalign(
            0
        )


        panel.pack_start(
            connection_label,
            False,
            False,
            0,
        )


        connection_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=7,
        )


        self.wifi = CircularIndicator(
            "WIFI",
            "󰖩",
            ACCENT,
            48,
        )


        self.bluetooth = CircularIndicator(
            "BLUETOOTH",
            "󰂯",
            PURPLE,
            48,
        )


        self.wifi_item = ConnectionItem(
            self.wifi,
            "󰖩",
            "Wi-Fi",
        )


        self.bluetooth_item = ConnectionItem(
            self.bluetooth,
            "󰂯",
            "Bluetooth",
        )


        connection_box.pack_start(
            self.wifi_item,
            False,
            False,
            0,
        )


        connection_box.pack_start(
            self.bluetooth_item,
            False,
            False,
            0,
        )


        panel.pack_start(
            connection_box,
            False,
            False,
            0,
        )


        # ====================================================
        # MUSIC BAR
        # ====================================================

        self.music = MusicBar()


        panel.pack_start(
            self.music,
            False,
            False,
            0,
        )


        # ====================================================
        # APPLICATIONS
        # ====================================================

        apps_label = Gtk.Label(
            label="APPLICATIONS"
        )

        apps_label.set_name(
            "section-label"
        )

        apps_label.set_xalign(
            0
        )


        panel.pack_start(
            apps_label,
            False,
            False,
            0,
        )


        apps = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=4,
        )


        definitions = [

            (
                "Spotify",
                [
                    "spotify.desktop",
                    "spotify",
                ],
                "spotify",
                "multimedia-player",
            ),

            (
                "VS Code",
                [
                    "code.desktop",
                    "visual-studio-code.desktop",
                    "com.visualstudio.code.desktop",
                ],
                "code",
                "text-editor",
            ),

            (
                "Chrome",
                [
                    "google-chrome.desktop",
                    "google-chrome-stable.desktop",
                    "com.google.Chrome.desktop",
                ],
                "google-chrome-stable || google-chrome",
                "web-browser",
            ),

            (
                "ChatGPT",
                [
                    "chatgpt.desktop",
                    "com.openai.chatgpt.desktop",
                    "com.openai.ChatGPT.desktop",
                    "ChatGPT.desktop",
                ],
                (
                    "if command -v "
                    "google-chrome-stable "
                    "> /dev/null 2>&1; then "
                    "google-chrome-stable "
                    "--app='https://chatgpt.com'; "
                    "elif command -v "
                    "google-chrome "
                    "> /dev/null 2>&1; then "
                    "google-chrome "
                    "--app='https://chatgpt.com'; "
                    "else "
                    "xdg-open "
                    "'https://chatgpt.com'; fi"
                ),
                "chat",
            ),
        ]


        for (
            name,
            candidates,
            fallback,
            fallback_icon,
        ) in definitions:


            button = Gtk.Button()

            button.set_relief(
                Gtk.ReliefStyle.NONE
            )

            button.set_name(
                "app-button"
            )


            content = Gtk.Box(
                orientation=Gtk.Orientation.VERTICAL,
                spacing=3,
            )


            circle = Gtk.EventBox()

            circle.set_name(
                "app-circle"
            )

            circle.set_size_request(
                40,
                40,
            )


            app = find_desktop_app(
                candidates
            )


            if app:

                try:
                    icon = app.get_icon()
                except Exception:
                    icon = None

                if icon:

                    image = (
                        Gtk.Image.new_from_gicon(
                            icon,
                            Gtk.IconSize.DIALOG,
                        )
                    )

                else:

                    image = (
                        Gtk.Image.new_from_icon_name(
                            fallback_icon,
                            Gtk.IconSize.DIALOG,
                        )
                    )

            else:

                image = (
                    Gtk.Image.new_from_icon_name(
                        fallback_icon,
                        Gtk.IconSize.DIALOG,
                    )
                )


            image.set_pixel_size(
                21
            )


            circle.add(
                image
            )


            label = Gtk.Label(
                label=name
            )

            label.set_name(
                "app-label"
            )


            content.pack_start(
                circle,
                False,
                False,
                0,
            )

            content.pack_start(
                label,
                False,
                False,
                0,
            )


            button.add(
                content
            )


            button.connect(
                "clicked",
                lambda
                _,
                c=candidates,
                f=fallback:
                    self.launch_app(
                        c,
                        f,
                    ),
            )


            apps.pack_start(
                button,
                True,
                True,
                0,
            )


        panel.pack_start(
            apps,
            False,
            False,
            0,
        )


        return panel


    # ========================================================
    # APP LAUNCH
    # ========================================================

    def launch_app(
        self,
        candidates,
        fallback,
    ):

        launch_app(
            candidates,
            fallback,
        )

        GLib.timeout_add(
            120,
            self.close,
        )


    # ========================================================
    # SYSTEM UPDATE
    # ========================================================

    def update_system(self):

        try:

            volume = get_volume()

            self.volume.set_value(
                volume / 100
            )


            if muted():

                self.volume.icon.set_text(
                    "󰝟"
                )

            elif volume <= 30:

                self.volume.icon.set_text(
                    "󰕿"
                )

            elif volume <= 70:

                self.volume.icon.set_text(
                    "󰖀"
                )

            else:

                self.volume.icon.set_text(
                    "󰕾"
                )


            cpu = psutil.cpu_percent(
                interval=None
            )

            self.cpu.set_value(
                cpu / 100
            )


            ram = (
                psutil.virtual_memory()
                .percent
            )

            self.ram.set_value(
                ram / 100
            )


            battery = (
                psutil.sensors_battery()
            )

            if battery:

                self.battery.set_value(
                    battery.percent / 100
                )

                if battery.power_plugged:

                    self.battery.icon.set_text(
                        "󰂄"
                    )

                elif battery.percent >= 80:

                    self.battery.icon.set_text(
                        "󰂂"
                    )

                elif battery.percent >= 50:

                    self.battery.icon.set_text(
                        "󰁿"
                    )

                elif battery.percent >= 20:

                    self.battery.icon.set_text(
                        "󰁽"
                    )

                else:

                    self.battery.icon.set_text(
                        "󰁺"
                    )


            brightness = get_brightness()

            self.brightness.set_value(
                self.get_brightness_percent()))


        except Exception:
            pass


        return True


    # ========================================================
    # CONNECTION UPDATE
    # ========================================================

    def update_connection(self):

        try:

            connected, name, signal = (
                get_wifi()
            )


            self.wifi_item.update(
                connected,
                signal / 100,
                name,
            )


            bt_connected, bt_name, bt_signal = (
                get_bluetooth()
            )


            self.bluetooth_item.update(
                bt_connected,
                bt_signal / 100,
                bt_name,
            )


        except Exception:
            pass


        return True


    # ========================================================
    # MUSIC UPDATE
    # ========================================================

    def update_music(self):

        try:
            self.music.update()
        except Exception:
            pass

        return True


    # ========================================================
    # OPEN
    # ========================================================

    def open(self):

        self.revealer.set_reveal_child(
            True
        )

        return False


    # ========================================================
    # CLOSE
    # ========================================================

    def close(self):

        self.revealer.set_reveal_child(
            False
        )

        GLib.timeout_add(
            230,
            self.destroy,
        )

        return False


    # ========================================================
    # DESTROY
    # ========================================================

    def destroyed(self, *_):

        cleanup_lock()

        try:
            Gtk.main_quit()
        except Exception:
            pass


# ============================================================
# MAIN
# ============================================================

try:

    capsule = Capsule()

    Gtk.main()

finally:

    cleanup_lock()

