#!/bin/bash

THEME="$HOME/.config/rofi/control-center.rasi"

wifi_state=$(nmcli -t -f STATE general | head -1)

if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    bt="󰂯  Bluetooth"
else
    bt="󰂲  Bluetooth"
fi

volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}')

battery=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)

choice=$(printf '%s\n' \
    "󰤨  Wi-Fi" \
    "$bt" \
    "  Audio     $volume%" \
    "󰁹  Battery   ${battery:-N/A}%" \
    "󰎆  Spotify" \
    "󰍺  Workspaces" \
    "󰉖  Wallpaper" \
    "󰒓  Settings" |
    rofi -dmenu \
        -i \
        -p "󰀻" \
        -theme "$THEME")

case "$choice" in
    "󰤨  Wi-Fi")
        wifi-menu
        ;;

    *"Bluetooth")
        bluetooth-menu
        ;;

    *"Audio"*)
        pavucontrol
        ;;

    *"Battery"*)
        powerprofilesctl get 2>/dev/null | \
            rofi -dmenu \
                -p "󰁹 Power profile" \
                -theme "$THEME"
        ;;

    "󰎆  Spotify")
        if pgrep -x spotify >/dev/null; then
            playerctl play-pause
        else
            spotify >/dev/null 2>&1 &
        fi
        ;;

    "󰍺  Workspaces")
        rofi -show window -theme "$THEME"
        ;;

    "󰉖  Wallpaper")
        wallpaperctl random
        ;;

    "󰒓  Settings")
        systemsettings5 >/dev/null 2>&1 &
        ;;
esac
