#!/bin/bash

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
STATE_FILE="$HOME/.cache/current-wallpaper"
MONITOR="eDP-1"

mkdir -p "$HOME/.cache"

get_wallpapers() {
    find "$WALLPAPER_DIR" -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
        | sort
}

set_wallpaper() {
    local wallpaper="$1"

    [ -z "$wallpaper" ] && exit 1

    echo "$wallpaper" > "$STATE_FILE"
    # hyprlock needs an image path, not the text state file.  Keep a stable
    # cache symlink so it always opens on the currently selected wallpaper.
    ln -sfn "$wallpaper" "$HOME/.cache/current-wallpaper-image"

    # swww supplies the reference-style corner reveal.  Do not start it here:
    # Hyprland starts exactly one wallpaper daemon at login.  The fallback
    # retains the user's established hyprpaper workflow.
    if command -v swww >/dev/null 2>&1 && swww query >/dev/null 2>&1; then
        swww img "$wallpaper" \
            --transition-type wipe \
            --transition-angle 45 \
            --transition-pos 0,0 \
            --transition-duration 1.05 \
            --transition-fps 60
    else
        hyprctl hyprpaper wallpaper "$MONITOR, $wallpaper, cover"
    fi

    matugen --config "$HOME/outlaw-rice/matugen/config.toml" --source-color-index 0 image "$wallpaper"


    
}

case "$1" in

    set)
        [ -f "$2" ] && set_wallpaper "$2"
        ;;

    next)
        mapfile -t wallpapers < <(get_wallpapers)

        [ "${#wallpapers[@]}" -eq 0 ] && exit 1

        current="$(cat "$STATE_FILE" 2>/dev/null)"

        for i in "${!wallpapers[@]}"; do
            if [[ "${wallpapers[$i]}" == "$current" ]]; then
                next=$(( (i + 1) % ${#wallpapers[@]} ))
                set_wallpaper "${wallpapers[$next]}"
                exit
            fi
        done

        set_wallpaper "${wallpapers[0]}"
        ;;

    random)
        mapfile -t wallpapers < <(get_wallpapers)

        [ "${#wallpapers[@]}" -eq 0 ] && exit 1

        wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"

        set_wallpaper "$wallpaper"
        ;;

    *)
        echo "Usage: wallpaperctl {set <file>|next|random}"
        ;;

esac
