* {
    font: "JetBrainsMono Nerd Font 12";

    bg: {{colors.surface.default.rgba | set_alpha: 0.78}};
    bg-alt: {{colors.surface_container.default.rgba | set_alpha: 0.82}};

    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};

    accent: #85d2e7;
    accent-soft: rgba(133, 210, 231, 0.16);

    border: rgba(133, 210, 231, 0.60);
    border-soft: rgba(191, 200, 203, 0.30);

    background-color: transparent;
    text-color: @fg;
}


window {
    width: 340px;

    transparency: "real";

    background-color: @bg;

    border: 1px;
    border-color: @border;
    border-radius: 16px;

    padding: 8px;

    location: north;
    y-offset: 42px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

/* ---------------------------------------------------- */
/* Input                                                 */
/* ---------------------------------------------------- */

inputbar {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border-soft;
    border-radius: 10px;

    padding: 7px 10px;
    spacing: 8px;

    children: [ textbox-prompt-colon, entry ];
}

textbox-prompt-colon {
    expand: false;

    str: "󰖩";

    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    text-color: @fg;
    vertical-align: 0.5;

    placeholder: "Search networks";
    placeholder-color: @fg-dim;

    cursor: text;
}

/* ---------------------------------------------------- */
/* List                                                  */
/* ---------------------------------------------------- */

listview {
    lines: 6;
    spacing: 2px;

    fixed-height: false;
    dynamic: true;

    scrollbar: false;
    cycle: true;
}

element {
    border-radius: 8px;

    padding: 7px 10px;
    spacing: 9px;

    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-dim;
}

/* Currently connected network */
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent-soft;

    /* Accent rail on the left rather than a full outline */
    border: 0px 0px 0px 2px;
    border-color: @accent;
    border-radius: 8px;

    text-color: @fg;
}

element-icon {
    size: 16px;
    vertical-align: 0.5;

    background-color: transparent;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;

    background-color: transparent;
}

/* ---------------------------------------------------- */
/* Messages (errors, "scanning...")                      */
/* ---------------------------------------------------- */

message {
    margin: 2px 0px 0px 0px;
}

textbox {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border-soft;
    border-radius: 8px;

    padding: 7px 10px;

    text-color: @fg-dim;
    vertical-align: 0.5;
}
