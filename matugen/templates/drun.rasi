 * {
    font: "JetBrainsMono Nerd Font 12";
    bg: {{colors.surface.default.rgba | set_alpha: 0.78}};
    bg-soft: {{colors.surface_container.default.rgba | set_alpha: 0.82}};
    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-soft: {{colors.primary.default.rgba | set_alpha: 0.16}};
    border: {{colors.primary.default.rgba | set_alpha: 0.70}};
    border-soft: {{colors.outline.default.rgba | set_alpha: 0.30}};
}
window {
    width: 390px;
    height: 650px;
    location: center;
    anchor: center;
    transparency: "real";
    background-color: @bg;
    border: 2.5px;
    border-color: @border;
    border-radius: 14px;
    padding: 12px;
}
mainbox {
    background-color: transparent;
    children: [
        inputbar,
        listview
    ];
    spacing: 10px;
}
inputbar {
    background-color: @bg-soft;
    border: 1.5px;
    border-color: @border;
    border-radius: 11px;
    padding: 10px 13px;
    children: [
        entry
    ];
}
prompt {
    enabled: false;
}
entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-dim;
}
listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 3px;
    scrollbar: false;
    fixed-height: false;
    padding: 2px 0px;
}
element {
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: 10px;
    padding: 8px 9px;
    spacing: 11px;
}
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-dim;
}
element selected.normal {
    background-color: @accent-soft;
    border: 1px;
    border-color: @border;
    text-color: @fg;
}
element-icon {
    background-color: transparent;
    size: 30px;
    horizontal-align: 0;
    vertical-align: 0.5;
}
element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0;
    vertical-align: 0.5;
}
