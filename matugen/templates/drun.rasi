* {
    font: "JetBrainsMono Nerd Font 12";

    bg: {{colors.surface.default.rgba | set_alpha: 0.72}};
    bg-alt: {{colors.surface_container.default.rgba | set_alpha: 0.78}};
    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-soft: {{colors.primary.default.rgba | set_alpha: 0.20}};
    border: {{colors.primary.default.rgba | set_alpha: 0.70}};
    border-soft: {{colors.outline.default.rgba | set_alpha: 0.32}};
}

window {
    width: 410px;
    transparency: "real";
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 18px;
    padding: 10px;
    location: north;
    y-offset: 48px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 7px;
}

inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-color: @border-soft;
    border-radius: 11px;
    padding: 8px 11px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0px 7px 0px 1px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 7;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
}

element {
    background-color: transparent;
    border-radius: 9px;
    padding: 7px 9px;
    spacing: 9px;
}

element normal, element alternate {
    background-color: transparent;
    text-color: @fg-dim;
}

element selected {
    background-color: @accent-soft;
    border: 1px;
    border-color: @border;
    text-color: @fg;
}

element-icon {
    background-color: transparent;
    size: 26px;
    horizontal-align: 0;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0;
    vertical-align: 0.5;
}
