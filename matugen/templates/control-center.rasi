* {
    font: "JetBrainsMono Nerd Font 13";

    bg: {{colors.surface.default.rgba | set_alpha: 0.72}};
    bg-alt: {{colors.surface_container.default.rgba | set_alpha: 0.82}};

    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};

    accent: {{colors.primary.default.hex}};
    accent-soft: {{colors.primary.default.rgba | set_alpha: 0.15}};

    border: {{colors.primary.default.rgba | set_alpha: 0.55}};
    border-soft: {{colors.outline.default.rgba | set_alpha: 0.28}};
}

window {
    width: 490px;

    transparency: "real";

    background-color: @bg;

    border: 1px;
    border-color: @border;

    border-radius: 24px;

    padding: 18px;
}

mainbox {
    background-color: transparent;

    children: [
        inputbar,
        listview
    ];

    spacing: 15px;
}

inputbar {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border-soft;

    border-radius: 15px;

    padding: 13px 15px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    text-color: @accent;
    padding: 0px 9px 0px 2px;
}

entry {
    background-color: transparent;

    text-color: @fg;

    placeholder: "Control center...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: transparent;

    lines: 8;
    spacing: 6px;

    scrollbar: false;
}

element {
    background-color: transparent;

    border-radius: 14px;

    padding: 13px 15px;
}

element normal {
    background-color: transparent;
    text-color: @fg-dim;
}

element alternate {
    background-color: transparent;
    text-color: @fg-dim;
}

element selected {
    background-color: @accent-soft;

    border: 1px;
    border-color: @border;

    text-color: @fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
