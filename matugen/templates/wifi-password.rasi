* {
    font: "JetBrainsMono Nerd Font 12";

    bg: {{colors.surface.default.rgba | set_alpha: 0.58}};
    bg-alt: {{colors.surface_container.default.rgba | set_alpha: 0.72}};

    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};

    accent: {{colors.primary.default.hex}};
    accent-soft: {{colors.primary.default.rgba | set_alpha: 0.16}};

    border: {{colors.primary.default.rgba | set_alpha: 0.60}};
    border-soft: {{colors.outline.default.rgba | set_alpha: 0.30}};
}

window {
    width: 350px;

    transparency: "real";

    background-color: @bg;

    border: 1px;
    border-color: @border;

    border-radius: 16px;

    padding: 10px;
}

mainbox {
    background-color: transparent;

    children: [
        message,
        inputbar
    ];

    spacing: 10px;
}

message {
    background-color: transparent;

    text-color: @fg;

    padding: 6px 10px 2px 10px;
}

inputbar {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border-soft;

    border-radius: 12px;

    padding: 11px 13px;

    children: [
        
        entry
    ];
}

entry {
    background-color: transparent;

    text-color: @fg;

    placeholder: "Enter password...";
    placeholder-color: @fg-dim;
}

textbox {
    background-color: transparent;
}
