* {
    font: "JetBrainsMono Nerd Font 12";

    bg: {{colors.surface.default.rgba | set_alpha: 0.78}};
    bg-alt: {{colors.surface_container.default.rgba | set_alpha: 0.82}};

    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};

    accent: #85d2e7;
    accent-soft: rgba(133, 210, 231, 0.16);

    border: rgba(133, 210, 231, 0.60);
    border-soft: rgba(191, 200, 203, 0.30);

    background-color: transparent;
    text-color: @fg;
}


window {
    width: 340px;

    transparency: "real";

    background-color: @bg;

    border: 1px;
    border-color: @border;
    border-radius: 16px;

    padding: 8px;

    location: north;
    y-offset: 42px;
}

mainbox {
    children: [ inputbar ];
    spacing: 0px;
}

inputbar {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border-soft;
    border-radius: 10px;

    padding: 8px 10px;
    spacing: 8px;

    children: [ textbox-prompt-colon, entry ];
}

textbox-prompt-colon {
    expand: false;

    str: "󰌾";

    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    text-color: @fg;
    vertical-align: 0.5;

    placeholder: "Wi-Fi password";
    placeholder-color: @fg-dim;

    cursor: text;
}

/* Shown when the password is rejected, via rofi -mesg */
message {
    margin: 8px 0px 0px 0px;
}

textbox {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border-soft;
    border-radius: 8px;

    padding: 7px 10px;

    text-color: @fg-dim;
    vertical-align: 0.5;
}
