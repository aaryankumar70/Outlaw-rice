* {
    font: "JetBrainsMono Nerd Font 12";
    bg: {{colors.surface.default.rgba | set_alpha: 0.74}};
    bg-alt: {{colors.surface_container.default.rgba | set_alpha: 0.82}};
    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-soft: {{colors.primary.default.rgba | set_alpha: 0.20}};
    border: {{colors.primary.default.rgba | set_alpha: 0.68}};
    border-soft: {{colors.outline.default.rgba | set_alpha: 0.30}};
}

window {
    width: 900px;
    transparency: "real";
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 24px;
    padding: 18px;
}

mainbox { background-color: transparent; children: [ inputbar, listview ]; spacing: 15px; }
inputbar { background-color: @bg-alt; border: 1px; border-color: @border-soft; border-radius: 14px; padding: 12px 15px; children: [ prompt, entry ]; }
prompt { text-color: @accent; padding: 0px 12px 0px 2px; }
entry { background-color: transparent; text-color: @fg; placeholder: "Choose wallpaper..."; placeholder-color: @fg-dim; }
listview { background-color: transparent; columns: 5; lines: 2; spacing: 12px; scrollbar: false; fixed-height: false; }
element { orientation: vertical; background-color: transparent; border-radius: 14px; padding: 8px; spacing: 7px; }
element normal, element alternate { text-color: @fg-dim; }
element selected { background-color: @accent-soft; border: 1px; border-color: @border; text-color: @fg; }
element-icon { background-color: transparent; size: 128px; horizontal-align: 0.5; vertical-align: 0.5; }
element-text { background-color: transparent; text-color: inherit; horizontal-align: 0.5; vertical-align: 0.5; }
